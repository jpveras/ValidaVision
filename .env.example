# Google Gemini API
# Gere sua chave em https://aistudio.google.com/apikey e cole abaixo.
# Chaves novas começam com "AQ." (as antigas começavam com "AIza"). As duas formas são aceitas.
# Sem aspas e sem espaços.
GEMINI_API_KEY=COLOQUE_SUA_CHAVE_AQUI

# Pode listar mais de um modelo separado por vírgula.
# Se o primeiro não existir, travar ou estiver sobrecarregado, o próximo é tentado.
# O 3.6 primeiro foi o mais rápido nos testes (~15 s por análise).
GEMINI_MODEL=gemini-3.6-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# true = testa a interface sem chamar nenhuma API.
DEMO_MODE=false

PORT=3000

# ---- Elogie um Colega ----
# Quantos elogios liberam a nuvem de palavras.
ELOGIOS_META=15
# Chave para moderar (remover um elogio ou zerar tudo) no modo apresentação.
# Escolha uma senha sua. Sem ela, ninguém consegue apagar elogios.
ELOGIOS_ADMIN_KEY=

# ---- Sentimento da Semana ----
# Tamanho da equipe (usado na análise da IA e na barra de progresso).
SENTIMENTO_EQUIPE=15
# Quantas palavras cada pessoa (navegador) pode enviar por semana. Padrão: 3.
SENTIMENTO_MAX_ENVIOS=3
# Senha do painel da gestora (/sentimento-gestora.html). Sem ela o painel fica bloqueado.
SENTIMENTO_GESTORA_KEY=

# ---- IA reserva (opcional) ----
# Se o Gemini falhar ou demorar, outra IA faz a análise. Sem chave de reserva, só o Gemini é usado.
# Cloudflare Workers AI (plano gratuito, 10.000 Neurons/dia, sem cartão):
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=b3cc5e4502af4e4d71ea25c711a6fe0d
# CLOUDFLARE_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct,@cf/meta/llama-4-scout-17b-16e-instruct
# Mistral (a API exige plano pago):
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-medium-2508,mistral-small-2506
# Segundos que o Gemini tem antes de passar para a reserva (padrão 75).
# RESERVA_APOS_S=75
